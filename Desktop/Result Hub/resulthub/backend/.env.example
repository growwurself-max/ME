# Firebase Admin SDK (Service Account)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Server
PORT=4000
CORS_ORIGIN=https://result-hub-ten.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Seed script (first Super Admin)
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=admin@resulthub.com
SEED_SUPER_ADMIN_PASSWORD=DevSuperAdmin123!

# Firebase Emulators (local development only)
EMULATOR=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Seed script (default College Admin)
SEED_COLLEGE_NAME=Example College
SEED_COLLEGE_PRINCIPAL=Dr. John Doe
SEED_COLLEGE_EMAIL=college@resulthub.com
SEED_COLLEGE_PHONE=+1-555-0100
SEED_COLLEGE_USERNAME=collegeadmin
SEED_COLLEGE_PASSWORD=DevCollegeAdmin123!
