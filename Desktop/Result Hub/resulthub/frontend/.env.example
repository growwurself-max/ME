# Base URL of the Express API
# For local development: http://localhost:4000
# For production: https://result-hub-ve8j.onrender.com
VITE_API_URL=http://localhost:4000

# Use local Firebase emulators instead of the live project (dev only)
VITE_USE_FIREBASE_EMULATOR=true

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
